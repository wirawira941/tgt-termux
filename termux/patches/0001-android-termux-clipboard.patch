+#[cfg(target_os = "android")]
+fn termux_clipboard_set(text: &str) {
+    use std::io::Write;
+    if let Ok(mut child) = std::process::Command::new("termux-clipboard-set")
+        .stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .spawn()
+    {
+        if let Some(mut stdin) = child.stdin.take() {
+            let _ = stdin.write_all(text.as_bytes());
+        }
+        let _ = child.wait();
+    }
+}
+
+/// Read the clipboard text on Android through the Termux:API command
+/// `termux-clipboard-get`. Returns None when Termux:API is missing or
+/// the clipboard cannot be read.
+#[cfg(target_os = "android")]
+fn termux_clipboard_get() -> Option<String> {
+    let out = std::process::Command::new("termux-clipboard-get")
+        .output()
+        .ok()?;
+    if out.status.success() {
+        let text = String::from_utf8_lossy(&out.stdout).into_owned();
+        Some(text.trim_end_matches(['\r', '\n']).to_string())
+    } else {
+        None
+    }
+}
