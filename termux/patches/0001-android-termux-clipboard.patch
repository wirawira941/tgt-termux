 use arboard::Clipboard;
+
+/// Set the clipboard text on Android through the Termux:API command
+/// `termux-clipboard-set`. Best effort: silently does nothing when
+/// Termux:API is not installed.
+#[cfg(target_os = "android")]
+fn termux_clipboard_set(text: &str) {
+    use std::io::Write;
+    if let Ok(mut child) = std::process::Command::new("termux-clipboard-set")
+        .stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .spawn()
+    {
+        if let Some(mut stdin) = child.stdin.take() {
+            let _ = stdin.write_all(text.as_bytes());
+        }
+        let _ = child.wait();
+    }
+}
